execute if entity @e[tag=dummy,scores={healthSyncCheck=0}] run execute as @e[tag=craig_health] at @e[tag=craig_health] if entity @e[tag=micheal_health,distance=5..] run scoreboard players add @e[tag=dummy] healthSyncCheck 1
execute if entity @e[tag=dummy,scores={healthSyncCheck=1}] run tellraw @a {"text":"Craig and Micheal fall out of sync!","color":"yellow"}
execute if entity @e[tag=dummy,scores={healthSyncCheck=1..}] run scoreboard players add @e[tag=dummy] healthSyncCheck 1
execute if entity @e[tag=dummy,scores={healthSyncCheck=100..}] run scoreboard players set @e[tag=dummy] healthSyncCheck 0